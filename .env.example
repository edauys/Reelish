# Copy to .env.local and fill in your Supabase project values.
# Dashboard: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-only key for admin tasks (not required for this MVP).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Recipe extraction (OpenAI) ---
# Server-only: never use NEXT_PUBLIC_* for the API key.
# If OPENAI_API_KEY is empty or unset, Reelish uses the offline mock extractor.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Same API key as above — Whisper + vision use these defaults unless overridden.
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_VISION_MODEL=gpt-4o-mini
# Optional: server terminal only — safe extraction diagnostics (path, key length, model, OpenAI error message).
# REELISH_DEBUG_EXTRACTION=1
# Abort OpenAI extraction HTTP if it exceeds this (large multimodal prompts). Default 120000 ms.
# REELISH_EXTRACTION_TIMEOUT_MS=120000

# --- Auth & rate limits (production) ---
# Uploads default to requiring a Supabase session. Set to 0 only for local API testing without login.
# REELISH_UPLOAD_REQUIRE_AUTH=0
# Extraction: unset = require auth in production only; 1 = always require; 0 = allow anonymous (IP rate limit).
# REELISH_EXTRACT_REQUIRE_AUTH=
# Optional overrides (see lib/rate-limit/in-memory.ts):
# REELISH_RATE_UPLOAD_PER_HOUR=60
# REELISH_RATE_UPLOAD_BURST=8
# REELISH_RATE_UPLOAD_BURST_MS=10000
# REELISH_RATE_EXTRACT_PER_HOUR=120
# REELISH_RATE_EXTRACT_BURST=15
# REELISH_RATE_EXTRACT_BURST_MS=60000
# REELISH_RATE_ANON_EXTRACT_PER_HOUR=40

# --- Telemetry (structured JSON logs to console; no raw captions) ---
# REELISH_TELEMETRY=1
# REELISH_SHARE_DEBUG=1

# --- URL enrichment (server-side, before extraction; weak public metadata — does not replace extraction) ---
# Tier: `official` (default) = Open Graph / basic meta only; `none` = disabled; `experimental` allows optional body sample when flags below are set.
# REELISH_URL_ENRICHMENT_TIER=official
# Experimental visible-text sample (very weak). Requires explicit opt-in:
# REELISH_EXPERIMENTAL_URL_FETCH=1
# REELISH_URL_ENRICHMENT_EXPERIMENTAL=1
#
# Instagram: optional public oEmbed attempt (weak; often 401/403). See `lib/url-enrichment/experimental-instagram-social.ts`.
# When unset or not `1`, Reelish does not call Instagram oEmbed — link-only + teaser text stays honest and minimal.
# REELISH_EXPERIMENTAL_INSTAGRAM_SOCIAL_FETCH=1

# --- Source retrieval orchestrator (additive; wraps URL enrichment + cache) ---
# Default: enabled (any value other than `0`). When `0` or `REELISH_RETRIEVAL_DISABLED=1`, Reelish uses the legacy path:
# a single `resolveUrlEnrichment` call with no retrieval cache or share/media diagnostic providers.
# REELISH_RETRIEVAL_ORCHESTRATOR=0
# REELISH_RETRIEVAL_DISABLED=1
#
# Disk cache (`PROJECT_ROOT/.data/reelish-retrieval-cache/` unless overridden). Disable with REELISH_RETRIEVAL_CACHE=0 or REELISH_RETRIEVAL_CACHE_DISABLED=1.
# REELISH_RETRIEVAL_CACHE=0
# REELISH_RETRIEVAL_CACHE_DISABLED=1
# REELISH_RETRIEVAL_CACHE_DIR=/absolute/path
# TTL seconds for cache entries (default 86400; minimum enforced in code).
# REELISH_RETRIEVAL_CACHE_TTL_SEC=86400
#
# Optional TikTok/vm short-link HEAD redirect before fetch (often blocked — off by default).
# REELISH_RETRIEVAL_RESOLVE_SHORT_URLS=1
#
# Skip live public HTTP/metadata fetch (`resolveUrlEnrichment`) while orchestrator stays on — share diagnostics + optional cache replay still run.
# REELISH_RETRIEVAL_PUBLIC_HTTP=0
#
# Stronger Instagram/TikTok recovery for link-only imports: public oEmbed, then safe HTML + embedded JSON hints (no login).
# Also enables Instagram oEmbed in the legacy URL enrichment path. Often blocked — failures stay honest.
# REELISH_EXPERIMENTAL_SOCIAL_RETRIEVAL=1
#
# Max bytes to read from Instagram/TikTok HTML (partial buffer parsed when truncated). Default 2097152 (2 MiB).
# REELISH_SOCIAL_RETRIEVAL_MAX_BYTES=2097152

# --- Client: native Capacitor shell / handoff debug (Safari Web Inspector → Console) ---
# Verbose: NEXT_PUBLIC_REELISH_NATIVE_LAUNCH_DEBUG=1
# Handoff only: NEXT_PUBLIC_REELISH_NATIVE_BRIDGE_DEBUG=1  (real device: Safari → Develop → iPhone → Reelish)
# In development, `[reelish:native-launch]` logs once without env (WebView href + getLaunchUrl).

# --- Media storage backend (default local disk; s3 not implemented yet) ---
# REELISH_MEDIA_STORAGE_BACKEND=local

# --- Local media ingest (share-target + /api/media/upload) ---
# Defaults to PROJECT_ROOT/.data/reelish-media
# REELISH_MEDIA_DIR=/absolute/path/to/media
# ffmpeg must be on PATH for video frame + audio extraction (or set binary path):
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# REELISH_MAX_VIDEO_FRAMES=6

# --- Capacitor native shell (optional) ---
# When set, `capacitor.config.ts` injects server.url so the iOS/Android WebView loads this origin
# (e.g. local dev: http://192.168.x.x:3000 — use your LAN IP so a physical device can reach your machine).
# Production builds often omit this and load your deployed https:// URL via CI or a second config.
# Overrides default in capacitor.config.ts (192.168.1.167:3000). Use when your LAN IP changes.
# CAPACITOR_SERVER_URL=http://192.168.1.167:3000
#
# Use the same host you open in the device browser for parity (LAN IP + `next dev --hostname 0.0.0.0`).
# Android emulator → host loopback: http://10.0.2.2:3000
