{
  "name": "Reelish",
  "short_name": "Reelish",
  "description": "Save a viral recipe. Make it fit you.",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#1A1614",
  "theme_color": "#1A1614",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["audio/*", "image/*", "video/*"]
        }
      ]
    }
  }
}
